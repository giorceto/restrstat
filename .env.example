APP_NAME="TC Статистики"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# с /restrstat накрая, ако се отваря на sales.tours-club.com/restrstat
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Sofia

APP_LOCALE=bg
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# нашата база (MariaDB на сървъра; локално може и sqlite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restrstat
DB_USERNAME=restrstat
DB_PASSWORD=
DB_COLLATION=utf8mb4_unicode_ci

# бисквитката е отделна от тази на tc-sales (същия домейн)
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_COOKIE=restrstat_session
SESSION_PATH=/restrstat
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# SAMO-Tour — САМО ЧЕТЕНЕ (tcsales_ro). Хостът е разделът [samo] в /etc/freetds/freetds.conf.
SAMO_DB_HOST=samo
SAMO_DB_DATABASE=TOURSCLUB
SAMO_DB_USERNAME=
SAMO_DB_PASSWORD=
# тегленето всеки час — включи го, когато samo:check минава
SAMO_SYNC=false
SAMO_SYNC_DAYS=14
# ако колоните на dbo.[order] се казват другояче (samo:check показва кои липсват):
# SAMO_ORDER_SUPPLIER=partner
# SAMO_ORDER_HOTEL=hotel
# SAMO_ORDER_TOWN=town
# SAMO_ORDER_COUNTRY=state
# SAMO_ORDER_DATE_FROM=datebeg
# SAMO_ORDER_DATE_TO=dateend
# SAMO_PARTNER_COUNTRY=state
